<!-- Samsung ATNA40HQ01-0 (SDC 0x4203) eDP OLED of the MOTOROLA 83NY. Derived
     from the stock Googlebook OLED configuration. Luminance values are the
     panel EDID HDR static metadata: 1107.128 cd/m2 peak, 496.743 cd/m2 frame
     average. SDR tops out at the frame average; the range above it is HDR
     headroom, which is what lets SurfaceFlinger dim SDR layers next to HDR.
     Backlight value 0.0 must stay the first point (DisplayDeviceConfig rejects a
     higher raw minimum). The physical floor is vendor.hwc.drm.min_display_brightness
     = 0.0069735, the previous slider-20% output, giving 7.72 nits. The HDR ratio
     follows the Pixel shape: 8x, then limited by the panel peak. -->
<displayConfiguration>
    <name>Internal Display</name>
    <screenBrightnessMap interpolation="linear">
        <point>
            <value>0.0</value>
            <nits>7.720</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>1107.0</nits>
        </point>
    </screenBrightnessMap>
    <screenBrightnessDefault>0.10980392157</screenBrightnessDefault>
    <thermalThrottling>
