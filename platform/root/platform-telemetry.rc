service gbos-battery-telemetry /postinstall/gbrunch/gbos-telemetry --watch-platform /postinstall/gbrunch/telemetry
    user root
    group root system
    seclabel u:r:init:s0
    priority 10
    disabled

on property:sys.boot_completed=1
    exec u:r:vendor_init:s0 root root -- /system/bin/sh -c "if [ -f /postinstall/gbrunch/telemetry/battery-ready ] || [ -f /postinstall/gbrunch/telemetry/platform-ready ]; then setprop vendor.gbos.battery.ready 1; fi"

on property:vendor.gbos.battery.ready=1
    start gbos-battery-telemetry
